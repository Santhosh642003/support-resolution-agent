# Copy to .env (git-ignored). Placeholders only; never commit real keys.
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://support:support@127.0.0.1:5432/support
LLM_PROVIDER=fake
LLM_MODEL=
# FakeAdapter fixtures (scenario ID + step index); required for LLM_PROVIDER=fake
LLM_FIXTURES_DIR=
# Set only when LLM_PROVIDER=groq / gemini (one line each; a duplicated key line silently wins last):
GROQ_API_KEY=
GEMINI_API_KEY=
# Provider limits (LLM_RPM/TPM/RPD/TPD) have version-controlled DEFAULTS in app/config.py
# (25 / 7000 / 900 / 180000, from the measured free-tier limits). Set one here only to override it.
# An EMPTY value would disable that limit, so leave the line out rather than blank.
# read_write | replay_only | off
LLM_CACHE_MODE=read_write
# Projected (paid-tier) prices per 1k tokens, for cost projection only
LLM_PRICE_PER_1K_IN=0
LLM_PRICE_PER_1K_OUT=0
# docker-compose Postgres (local dev defaults; not secrets)
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
POSTGRES_PORT=5432
